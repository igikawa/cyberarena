# Copy this file to .env and replace every CHANGE_ME value before starting.
# Generate each secret independently with: openssl rand -hex 32
POSTGRES_DB=cyberarena
POSTGRES_USER=cyberarena
POSTGRES_PASSWORD=CHANGE_ME_USE_A_RANDOM_URL_SAFE_PASSWORD

REDIS_USER=cyberarena
REDIS_USER_PASSWORD=CHANGE_ME_USE_A_RANDOM_URL_SAFE_PASSWORD

SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_WITH_OPENSSL
FLAG_HMAC_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET
LAB_MATERIALS_SECRET=CHANGE_ME_GENERATE_ANOTHER_DIFFERENT_RANDOM_SECRET
LAB_MANAGER_SECRET=CHANGE_ME_GENERATE_A_SEPARATE_RANDOM_SECRET
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_GRAFANA_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_LONG_ADMIN_PASSWORD
COOKIE_SECURE=false
# Set COOKIE_SECURE=true when serving through HTTPS.